.claude-state/
.DS_Store
# preview/ 是本地制品目录（状态页、临时预览），整体不入库——
# 但 D111 生成的政策静态页是**从源文案派生的交付物**，
# 防漂移门（PolicySiteTests）比对的就是「仓里 check-in 的那份」：
# 不入库的话那条门在新 clone 上根本无从比对，等于没有。
preview/*
!preview/landing/
preview/landing/*
!preview/landing/privacy.html
!preview/landing/terms.html
!preview/landing/support.html

# SwiftPM
.build/
Packages/*/.build/

# Python
__pycache__/
*.pyc

# Claude 工作产物
.claude/worktrees/
.planning/
.shots/

# Xcode user state
**/xcuserdata/
**/*.xcuserstate
Packages/*/.swiftpm/
app-shell/ClosetApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# TestFlight / local secrets
app-shell/build/
app-shell/.env.asc
**/*.ipa
**/*.xcarchive
